---
import WavetableDiagram from '../WavetableDiagram.astro';

interface Props {
  // what the drawing shows, for those who don't see it
  label: string;
}

// a wavetable as the landing draws it (a drawing of the build, no picture file): its frames stacked from a sine to a
// saw, the one the Wave knob plays lit, on a dark panel as the screens of the synth are, and what to look at (the
// slot). Once to a page: the gradient of the drawing has an id
const { label } = Astro.props;
---

<figure class='stack'>
  <div class='panel'>
    <WavetableDiagram label={label} />
  </div>
  {Astro.slots.has('default') && (
    <figcaption>
      <slot />
    </figcaption>
  )}
</figure>

<style>
  .stack {
    margin: 28px 0;
  }

  .panel {
    max-width: min(520px, 100%);
    padding: 12px;
    border-radius: 8px;
    background:
      linear-gradient(rgb(255 255 255 / 4%) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(180deg, rgb(22 33 43 / 90%), rgb(18 26 34 / 90%));
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 6%),
      var(--raised);
  }

  .panel :global(.drawing) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 10px;
    font-size: 15px;
    color: var(--text-muted);
  }
</style>
