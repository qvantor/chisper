---
interface Props {
  // the wordmark of the header (large) or of the footer
  size?: 'large' | 'small';
  // the page it leads to (the landing of the language)
  href: string;
}

const { size = 'large', href } = Astro.props;
---

<a class:list={['logo', size]} href={href}>
  <span class='name'>Chisper</span>
  <span class='by'>by Qvantor</span>
</a>

<style>
  /* the wordmark of the synth's header: gradient letters, "by Qvantor" under their right end */
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1;
    text-decoration: none;
    transition: filter 250ms ease;
  }

  /* a link: the whole wordmark lights up a little, nothing changes color */
  .logo:hover {
    filter: brightness(1.15) saturate(1.1);
  }

  .name {
    font-weight: 700;
    font-size: 32px;
    text-transform: uppercase;
    background: var(--logo);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .by {
    margin-top: 2px;
    font-weight: 700;
    font-size: 12px;
    color: var(--text-muted);
  }

  .small .name {
    font-size: 22px;
  }

  .small .by {
    font-size: 11px;
  }
</style>
