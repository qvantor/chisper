---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import Faq from './Faq.astro';
import Feature from './Feature.astro';
import Finale from './Finale.astro';
import Footer from './Footer.astro';
import Head from './Head.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Listen from './Listen.astro';
import Noise from './Noise.astro';
import Synthesis from './Synthesis.astro';
import Track from './Track.astro';
import editor from '../assets/editor.png';
import filter from '../assets/filter.png';
import fx from '../assets/fx.png';
import modulation from '../assets/modulation.png';
import osc from '../assets/osc.png';
import phone from '../assets/phone.png';
import synth from '../assets/synth.png';
import unison from '../assets/unison.png';
import { demosOf, type Section } from '../data/demos';
import { MESSAGES, type Messages } from '../i18n';
import type { Lang } from '../i18n/locales';
import { LANDING_PATHS, manualPath, type ManualPage } from '../manual/pages';
import { jsonLd } from '../seo/json-ld';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const m = MESSAGES[lang];

// the features with clips, in the order of the page: the label is the name the synth gives the part (its color
// FEATURE_COLORS of art/scenes.ts), the image that part on the presets of the clips (screens.mjs); the noise between
// them as in a voice (oscillators, noise, filter), a drawing beside it (Noise.astro); the piano roll after the keys
// that play into it, no clip, a drawing beside it (Track.astro); their pictures alternate sides from the left (the
// phone of Playing on the left), the editor after them goes on
const FEATURES: (
  | {
      section: Exclude<Section, 'listen' | 'noise'>;
      label: string;
      image: ImageMetadata;
      phone?: boolean;
    }
  | { section: 'noise' }
  | { section: 'track' }
)[] = [
  { section: 'wavetables', label: 'Osc 1 · Osc 2', image: osc },
  { section: 'unison', label: 'Unison', image: unison },
  { section: 'noise' },
  { section: 'filter', label: 'Filter', image: filter },
  { section: 'modulation', label: 'ENV · LFO · VELO', image: modulation },
  { section: 'effects', label: 'FX', image: fx },
  { section: 'playing', label: 'Voicing · Keys', image: phone, phone: true },
  { section: 'track' },
];

// the page of the manual each section leads to (its link named by `more` of its messages)
const MORE: Partial<Record<keyof Messages['features'], ManualPage>> = {
  wavetables: 'wavetables',
  modulation: 'modulation',
  playing: 'midi',
  editor: 'wavetables',
};
const moreOf = (section: keyof Messages['features']) => {
  const page = MORE[section];
  const feature = m.features[section];
  return page && 'more' in feature ? { href: manualPath(page, lang), label: feature.more } : undefined;
};

// the screenshot of the synth for the structured data: one webp of the width of the column
const screenshot = await getImage({ src: synth, format: 'webp', width: 1440 });
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head
      lang={lang}
      title={m.meta.title}
      description={m.meta.description}
      paths={LANDING_PATHS}
      ogType='website'
      ogImageAlt={m.meta.ogImageAlt}
      structured={jsonLd(lang, m, screenshot.src)}
    />
    <Font cssVariable='--font-inter-tight' preload />
  </head>
  <body>
    <Header lang={lang} m={m} />
    <main>
      <Hero m={m} />
      <Listen m={m} />
      <Synthesis m={m} />
      {FEATURES.map((feature, index) => {
        const side = index % 2 ? 'right' : 'left';
        if (feature.section === 'noise') return <Noise side={side} m={m} />;
        if (feature.section === 'track') return <Track side={side} m={m} />;
        const { section, label, image, phone } = feature;
        return (
          <Feature
            id={section}
            label={label}
            title={m.features[section].h2}
            text={m.features[section].text}
            more={moreOf(section)}
            demos={demosOf(section)}
            image={image}
            imageAlt={m.figures[section]}
            phone={phone}
            side={side}
            m={m}
          />
        );
      })}
      <Feature
        id='editor'
        label='Wavetable edit'
        title={m.features.editor.h2}
        text={m.features.editor.text}
        more={moreOf('editor')}
        image={editor}
        imageAlt={m.features.editor.screenshotAlt}
        side={FEATURES.length % 2 ? 'right' : 'left'}
        m={m}
      />
      <Feature
        id='presets'
        label='Presets'
        title={m.features.presets.h2}
        text={m.features.presets.text}
        m={m}
      >
        <div>
          <a class='key key-glow' href='/'>
            {m.features.presets.cta}
          </a>
        </div>
      </Feature>
      <Faq lang={lang} m={m} />
      <Finale m={m} />
    </main>
    <Footer lang={lang} m={m} paths={LANDING_PATHS} />
    <script>
      import { initPlayers } from '../scripts/player';
      import { animateScenesWhenIdle } from '../scripts/scenes';

      initPlayers();
      animateScenesWhenIdle();
    </script>
  </body>
</html>
