---
import BookIcon from './BookIcon.astro';
import Logo from './Logo.astro';
import type { Messages } from '../i18n';
import { LOCALES, type Lang } from '../i18n/locales';
import { MANUAL_HUB, manualPath } from '../manual/pages';

interface Props {
  lang: Lang;
  m: Messages;
}

// the wordmark (back to the landing of the language), the manual and the key into the synth; the languages are in
// the footer (and in the alternates of the head)
const { lang, m } = Astro.props;
---

<header class='header'>
  <div class='column bar'>
    <Logo href={LOCALES[lang].path} />
    <nav class='links'>
      <a class='key key-ghost manual' href={manualPath(MANUAL_HUB, lang)}>
        <BookIcon />
        {m.manual.name}
      </a>
      <a class='key key-glow open' href='/'>
        {m.openSynth}
      </a>
    </nav>
  </div>
</header>

<style>
  /* stays on top, the page under it blurred */
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(14 21 27 / 72%);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .manual,
  .open {
    min-height: 40px;
    padding: 0 16px;
    font-size: 12px;
  }

  .manual :global(.book) {
    font-size: 17px;
    color: var(--accent);
  }

  /* a phone: the wordmark and the manual (the first section has the key) */
  @media (max-width: 560px) {
    .open {
      display: none;
    }
  }
</style>
