---
import ManualLink from './ManualLink.astro';
import type { Messages } from '../i18n';
import type { Lang } from '../i18n/locales';
import { manualNav } from '../manual/entries';

interface Props {
  lang: Lang;
  m: Messages;
}

// the answers are in the HTML whether a question is open or not (crawlers read them); an answer the manual tells
// more of links its page (named as in the nav of the manual)
const { lang, m } = Astro.props;
const nav = await manualNav(lang);
const items = m.faq.items.map((item) => ({ ...item, link: nav.find(({ id }) => id === item.page) }));
---

<section class='section' id='faq' aria-labelledby='faq-title'>
  <div class='column'>
    <h2 id='faq-title'>{m.faq.h2}</h2>
    <div class='items'>
      {items.map(({ q, a, link }) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
          {link && (
            <div class='more'>
              <ManualLink href={link.href} kicker={m.manual.name} label={link.name} small />
            </div>
          )}
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* the questions on one raised surface, a line between them */
  .items {
    display: grid;
    gap: 1px;
    margin-top: 28px;
    background: var(--line);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: var(--raised);
  }

  details {
    background: var(--surface);
  }

  details[open] {
    background: var(--surface-high);
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    font-weight: 400;
    color: var(--accent);
  }

  details[open] summary::after {
    content: '−';
  }

  details p {
    padding: 0 20px 20px;
    color: var(--text-muted);
  }

  /* the page of the manual under an answer */
  details .more {
    margin-top: -6px;
    padding: 0 20px 20px;
  }
</style>
