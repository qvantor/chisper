---
import {
  LOOP_END_X,
  PLAYHEAD_X,
  ROLL,
  ROLL_COLORS,
  ROW,
  type LineKind,
  keyLines,
  rollLines,
  rollNotes,
  rollRows,
  rollStems,
} from '../art/track';

interface Props {
  // what it shows, for those who don't see it
  label: string;
}

// the clip of the page on the piano roll of the synth, filling its dark screen (the screen is the figure's): the
// keys of two octaves left of the rows (the rows of the white keys lighter), the bars numbered in the ruler with the
// loop marked under them and its end, the part past it shaded; the notes colored by their velocity, those the
// playhead is in lighter; under them the lane of the velocities. The names (C3, VEL, the bars) are the synth's, the
// same in every language
const { label } = Astro.props;
const rows = rollRows();
const lines = rollLines();
const LINE_STYLE: Record<LineKind, { stroke: string; opacity: string }> = {
  step: { stroke: ROLL_COLORS.line, opacity: '0.7' },
  beat: { stroke: ROLL_COLORS.high, opacity: '0.3' },
  bar: { stroke: ROLL_COLORS.high, opacity: '0.65' },
};
const grid = { top: ROLL.top, bottom: ROLL.laneBottom };
---

<svg class='drawing' viewBox={`0 0 ${ROLL.width} ${ROLL.height}`} role='img' aria-label={label}>
  <rect width={ROLL.width} height={ROLL.height} fill={ROLL_COLORS.background} />
  <g fill={ROLL_COLORS.line} fill-opacity='0.28'>
    {rows
      .filter(({ black }) => !black)
      .map(({ y }) => (
        <rect x={ROLL.keys} y={y} width={ROLL.width - ROLL.keys} height={ROW} />
      ))}
  </g>
  <g stroke-width='1'>
    {lines.map(({ x, kind }) => (
      <line
        x1={x}
        y1={grid.top}
        x2={x}
        y2={kind === 'step' ? ROLL.bottom : grid.bottom}
        stroke={LINE_STYLE[kind].stroke}
        stroke-opacity={LINE_STYLE[kind].opacity}
      />
    ))}
    {rows
      .filter(({ name }) => name)
      .map(({ y }) => (
        <line x1={ROLL.keys} y1={y + ROW} x2={ROLL.width} y2={y + ROW} stroke={ROLL_COLORS.line} />
      ))}
    <line
      x1={ROLL.keys}
      y1={ROLL.laneTop - 7}
      x2={ROLL.width}
      y2={ROLL.laneTop - 7}
      stroke={ROLL_COLORS.line}
    />
  </g>
  <rect
    x={LOOP_END_X}
    y={grid.top}
    width={ROLL.width - LOOP_END_X}
    height={grid.bottom - grid.top}
    fill='#000'
    fill-opacity='0.38'
  />
  <rect x={LOOP_END_X - 1} y={grid.top} width='2' height={grid.bottom - grid.top} fill={ROLL_COLORS.loop} />
  <g>
    {rollNotes().map(({ x, y, width, height, color, playing }) => (
      <rect
        class:list={['note', { playing }]}
        x={x}
        y={y}
        width={width}
        height={height}
        rx='2'
        fill={color}
      />
    ))}
  </g>
  <g stroke-width='2' stroke-linecap='round'>
    {rollStems().map(({ x, top, color }) => (
      <g class='stem'>
        <line x1={x} y1={ROLL.laneBottom} x2={x} y2={top} stroke={color} />
        <circle cx={x} cy={top} r='2.6' fill={color} />
      </g>
    ))}
  </g>
  <rect width={ROLL.width} height={ROLL.top} fill={ROLL_COLORS.ruler} />
  <rect
    x={ROLL.keys}
    y={ROLL.top - 6}
    width={LOOP_END_X - ROLL.keys}
    height='4'
    rx='1'
    fill={ROLL_COLORS.loop}
  />
  {lines
    .filter(({ bar }) => bar)
    .map(({ x, bar }) => (
      <text class='bar' x={x + 5} y={ROLL.top - 10} fill={ROLL_COLORS.high}>
        {bar}
      </text>
    ))}
  <rect y={ROLL.top} width={ROLL.keys} height={ROLL.bottom - ROLL.top} fill={ROLL_COLORS.keyWhite} />
  <g stroke={ROLL_COLORS.keyLine} stroke-width='1'>
    {keyLines().map((y) => (
      <line x1='0' y1={y} x2={ROLL.keys} y2={y} />
    ))}
  </g>
  <g fill={ROLL_COLORS.keyBlack}>
    {rows
      .filter(({ black }) => black)
      .map(({ y }) => (
        <rect y={y} width={ROLL.keys * 0.6} height={ROW} rx='1' />
      ))}
  </g>
  {rows
    .filter(({ name }) => name)
    .map(({ y, name }) => (
      <text class='key' x={ROLL.keys - 4} y={y + ROW - 2.5} text-anchor='end' fill={ROLL_COLORS.keyLabel}>
        {name}
      </text>
    ))}
  <rect x={ROLL.keys - 1} y={ROLL.top} width='1' height={ROLL.bottom - ROLL.top} fill={ROLL_COLORS.line} />
  <text class='lane' x={ROLL.keys / 2} y={ROLL.laneTop + 10} text-anchor='middle' fill={ROLL_COLORS.high}>
    VEL
  </text>
  <g fill={ROLL_COLORS.playhead}>
    <rect x={PLAYHEAD_X - 0.75} y={ROLL.top - 6} width='1.5' height={grid.bottom - grid.top + 6} />
    <path d={`M${PLAYHEAD_X - 5} ${ROLL.top - 12}h10l-5 7z`} />
  </g>
</svg>

<style>
  /* the roll fills the screen: its corners those of the screen */
  .drawing {
    display: block;
    clip-path: inset(0 round 10px);
  }

  text {
    font-family: var(--font);
    font-weight: 600;
  }

  .bar {
    font-size: 12px;
  }

  .key {
    font-size: 9px;
  }

  .lane {
    font-size: 10px;
  }
</style>
