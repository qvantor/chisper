---
import { getCollection } from 'astro:content';
import Landing from '../components/Landing.astro';
import ArticlePage from '../components/manual/ArticlePage.astro';
import { LANGS, LOCALES, type Lang } from '../i18n/locales';
import { sectionEntries } from '../manual/entries';
import { SECTIONS, SECTION_PAGES, isSitePage, pagePath, type SitePage } from '../manual/pages';

interface Props {
  lang: Lang;
  page?: SitePage;
}

// the landing per language at the path of its locale; every page of the manual and of Learn per language at its own
// path. A text of no page or language, or a page without its text in a language, fails the build
export const getStaticPaths = async () => {
  for (const section of SECTIONS) {
    const ids = new Set((await getCollection(section)).map((entry) => entry.id));
    for (const id of ids) {
      const [lang, page] = id.split('/');
      if (!(LANGS as readonly string[]).includes(lang) || !page || !isSitePage(section, page))
        throw new Error(`src/content/${section}/${id}.mdx is no page of the section (src/manual/pages.ts)`);
    }
    await Promise.all(LANGS.map((lang) => sectionEntries(section, lang)));
  }
  const articles = SECTIONS.flatMap((section) => SECTION_PAGES[section]).flatMap((page) =>
    LANGS.map((lang) => ({ params: { page: pagePath(page, lang).slice(1, -1) }, props: { lang, page } }))
  );
  return [
    ...LANGS.map((lang) => ({ params: { page: LOCALES[lang].path.slice(1, -1) }, props: { lang } })),
    ...articles,
  ];
};

const { lang, page } = Astro.props;
---

{page ? <ArticlePage lang={lang} page={page} /> : <Landing lang={lang} />}
